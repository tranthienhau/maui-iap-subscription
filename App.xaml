<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:SubscriptionPro.Converters"
             x:Class="SubscriptionPro.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Styles/Colors.xaml" />
				<ResourceDictionary Source="Resources/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<conv:InvertBoolConverter x:Key="InvertBool" />
			<conv:NotNullConverter x:Key="NotNull" />
			<conv:EqualityMultiConverter x:Key="IsEqual" />
			<conv:SelectedToStrokeConverter x:Key="SelStroke" />
			<conv:SelectedToThicknessConverter x:Key="SelThickness" />
		</ResourceDictionary>
	</Application.Resources>
</Application>
