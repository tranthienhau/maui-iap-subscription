<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionPro.ViewModels"
             x:Class="SubscriptionPro.Views.SuccessPage"
             x:DataType="vm:SuccessViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

	<Grid RowDefinitions="64,*,Auto">

		<!-- Header -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,0" VerticalOptions="Center">
			<Label Grid.Column="0" Text="✕" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
			<Label Grid.Column="1" Text="Confirmation" Style="{StaticResource HeadlineSm}"
			       HorizontalOptions="Center" VerticalOptions="Center" />
		</Grid>

		<ScrollView Grid.Row="1" Padding="20,8,20,24">
			<VerticalStackLayout Spacing="0" HorizontalOptions="Fill">

				<!-- Success hero icon -->
				<Grid Margin="0,16,0,24" HorizontalOptions="Center">
					<Border x:Name="Badge" WidthRequest="128" HeightRequest="128"
					        BackgroundColor="{StaticResource PrimaryContainer}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 64" HorizontalOptions="Center">
						<Border.Shadow>
							<Shadow Brush="{StaticResource PrimaryContainer}" Offset="0,10" Radius="28" Opacity="0.35" />
						</Border.Shadow>
						<Label Text="✓" FontSize="64" FontAttributes="Bold"
						       TextColor="{StaticResource OnPrimaryContainer}"
						       HorizontalOptions="Center" VerticalOptions="Center" />
					</Border>
					<Border WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource SecondaryContainer}"
					        StrokeThickness="2" Stroke="{StaticResource Surface}" StrokeShape="RoundRectangle 16"
					        HorizontalOptions="End" VerticalOptions="Start" TranslationX="6" TranslationY="-6">
						<Label Text="✦" FontSize="15" TextColor="{StaticResource OnSecondaryContainer}"
						       HorizontalOptions="Center" VerticalOptions="Center" />
					</Border>
				</Grid>

				<Label Text="You're all set!" Style="{StaticResource DisplayLg}" HorizontalTextAlignment="Center" />
				<Label Text="Your premium subscription is now active. Welcome to the inner circle."
				       Style="{StaticResource BodyMd}" HorizontalTextAlignment="Center"
				       Margin="32,8,32,28" />

				<!-- Summary card -->
				<Border BackgroundColor="{StaticResource SurfaceContainerLow}" Stroke="{StaticResource OutlineVariant}"
				        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20" Margin="0,0,0,24">
					<VerticalStackLayout Spacing="16">
						<Grid ColumnDefinitions="*,Auto">
							<VerticalStackLayout Grid.Column="0" Spacing="2">
								<Label Text="ACTIVE PLAN" Style="{StaticResource LabelSm}" TextColor="{StaticResource Outline}" />
								<Label Text="{Binding PlanTitle}" Style="{StaticResource HeadlineSm}"
								       TextColor="{StaticResource Primary}" />
							</VerticalStackLayout>
							<Border Grid.Column="1" IsVisible="{Binding HasBadge}"
							        BackgroundColor="{StaticResource SecondaryContainer}" StrokeThickness="0"
							        StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center">
								<Label Text="{Binding BadgeText}" Style="{StaticResource LabelSm}"
								       TextColor="{StaticResource OnSecondaryContainer}" />
							</Border>
						</Grid>

						<BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" />

						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Perks}" Spacing="8">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<HorizontalStackLayout Spacing="8">
										<Label Text="✓" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
										<Label Text="{Binding .}" Style="{StaticResource BodyMd}" />
									</HorizontalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

						<BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" />

						<Grid ColumnDefinitions="*,Auto">
							<VerticalStackLayout Grid.Column="0" Spacing="2">
								<Label Text="Next Billing Date" Style="{StaticResource LabelSm}" TextColor="{StaticResource Outline}" />
								<Label Text="{Binding NextBillingDate}" Style="{StaticResource LabelMd}" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
								<Label Text="Price" Style="{StaticResource LabelSm}" TextColor="{StaticResource Outline}"
								       HorizontalTextAlignment="End" />
								<Label Text="{Binding Price}" Style="{StaticResource LabelMd}" HorizontalTextAlignment="End" />
							</VerticalStackLayout>
						</Grid>
					</VerticalStackLayout>
				</Border>

				<!-- Quick actions -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
					<Border Grid.Column="0" BackgroundColor="{StaticResource SurfaceContainerHigh}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 16" Padding="0,18">
						<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
							<Label Text="👤" FontSize="20" HorizontalOptions="Center" />
							<Label Text="Edit Profile" Style="{StaticResource LabelMd}" HorizontalOptions="Center" />
						</VerticalStackLayout>
					</Border>
					<Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceContainerHigh}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 16" Padding="0,18">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding ManageCommand}" />
						</Border.GestureRecognizers>
						<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
							<Label Text="⚙" FontSize="20" HorizontalOptions="Center" />
							<Label Text="Preferences" Style="{StaticResource LabelMd}" HorizontalOptions="Center" />
						</VerticalStackLayout>
					</Border>
				</Grid>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Bottom CTA -->
		<VerticalStackLayout Grid.Row="2" Padding="20,12,20,28" BackgroundColor="{StaticResource Surface}">
			<Button Text="Start Exploring" Style="{StaticResource PrimaryCta}"
			        Command="{Binding StartExploringCommand}">
				<Button.Shadow>
					<Shadow Brush="{StaticResource PrimaryContainer}" Offset="0,8" Radius="20" Opacity="0.30" />
				</Button.Shadow>
			</Button>
		</VerticalStackLayout>

	</Grid>
</ContentPage>
