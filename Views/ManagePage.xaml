<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubscriptionPro.ViewModels"
             x:Class="SubscriptionPro.Views.ManagePage"
             x:DataType="vm:ManageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

	<Grid RowDefinitions="64,*">

		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,0" VerticalOptions="Center">
			<Label Grid.Column="0" Text="‹" FontSize="28" TextColor="{StaticResource Primary}" VerticalOptions="Center">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding ChangePlanCommand}" />
				</Label.GestureRecognizers>
			</Label>
			<Label Grid.Column="1" Text="Manage Subscription" Style="{StaticResource HeadlineSm}"
			       HorizontalOptions="Center" VerticalOptions="Center" />
		</Grid>

		<ScrollView Grid.Row="1" Padding="20,8,20,28">
			<VerticalStackLayout Spacing="20">

				<!-- Active status card -->
				<Border BackgroundColor="{StaticResource SurfaceContainerLowest}" Stroke="{StaticResource OutlineVariant}"
				        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
					<VerticalStackLayout Spacing="16">
						<Grid ColumnDefinitions="*,Auto">
							<VerticalStackLayout Grid.Column="0" Spacing="2">
								<Label Text="CURRENT PLAN" Style="{StaticResource LabelSm}" TextColor="{StaticResource Outline}" />
								<Label Text="{Binding PlanTitle}" Style="{StaticResource HeadlineSm}"
								       TextColor="{StaticResource Primary}" />
								<Label Text="{Binding Price}" Style="{StaticResource BodyMd}" />
							</VerticalStackLayout>
							<Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryFixed}" StrokeThickness="0"
							        StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Start"
							        IsVisible="{Binding IsActive}">
								<Label Text="ACTIVE" Style="{StaticResource LabelSm}"
								       TextColor="{StaticResource OnPrimaryFixedVariant}" />
							</Border>
						</Grid>

						<BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" />

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Label Grid.Column="0" Text="🗓" FontSize="18" VerticalOptions="Center" />
							<Label Grid.Column="1" Text="{Binding RenewalStatus}" Style="{StaticResource BodyMd}"
							       VerticalOptions="Center" />
						</Grid>
					</VerticalStackLayout>
				</Border>

				<!-- Auto-renew row -->
				<Border BackgroundColor="{StaticResource SurfaceContainerLowest}" Stroke="{StaticResource OutlineVariant}"
				        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
					<Grid ColumnDefinitions="*,Auto">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label Text="Auto-renewal" Style="{StaticResource LabelMd}" />
							<Label Text="Your plan renews automatically each period." Style="{StaticResource LabelSm}" />
						</VerticalStackLayout>
						<Switch Grid.Column="1" IsToggled="{Binding AutoRenewing}" IsEnabled="False"
						        OnColor="{StaticResource Primary}" VerticalOptions="Center" />
					</Grid>
				</Border>

				<!-- Actions -->
				<Button Text="Cancel auto-renew" BackgroundColor="{StaticResource ErrorContainer}"
				        TextColor="{StaticResource OnErrorContainer}" FontFamily="HankenSemiBold"
				        HeightRequest="52" CornerRadius="12" Command="{Binding CancelRenewalCommand}"
				        IsVisible="{Binding AutoRenewing}" />

				<Button Text="Restore purchases" BackgroundColor="{StaticResource SurfaceContainerHigh}"
				        TextColor="{StaticResource OnSurface}" FontFamily="HankenSemiBold"
				        HeightRequest="52" CornerRadius="12" Command="{Binding RestoreCommand}" />

				<Button Text="Change plan" Style="{StaticResource PrimaryCta}"
				        Command="{Binding ChangePlanCommand}" />

				<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
				                   Color="{StaticResource Primary}" />

				<Label Text="Manage or cancel anytime in the App Store / Google Play account settings."
				       Style="{StaticResource LabelSm}" HorizontalTextAlignment="Center" Margin="8,4,8,0" />

			</VerticalStackLayout>
		</ScrollView>

	</Grid>
</ContentPage>
